<div class="file-comparison">
    <div class="file-header">
        <span class="file-name">📄 {{ifcFileName}}</span>
        <div class="file-stats">
            <span class="stat-badge {{schemaMatchClass}}">
                Schema {{schemaMatchIcon}}
            </span>
            <span class="stat-badge {{summaryMatchClass}}">
                Summary {{summaryMatchIcon}}
            </span>
            <span class="stat-badge {{geometryMatchClass}}">
                Geometry {{geometryMatchIcon}}
            </span>
            <span class="stat-badge {{imagesMatchClass}}">
                Images {{imagesMatchIcon}}
            </span>
        </div>
    </div>
    <div class="file-details">
        <h4>Processing Time</h4>
        <table>
            <thead>
                <tr>
                    <th>Parser</th>
                    <th>Version</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
                {{#each parsers}}
                    <tr>
                        <td>{{this.parserName}}</td>
                        <td>{{this.parserVersion}}</td>
                        <td>{{this.processingTimeMs}} ms</td>
                    </tr>
                {{/each}}
            </tbody>
        </table>

        <h4 style="margin-top: 1rem;">Summary Comparison</h4>
        <table>
            <thead>
                <tr>
                    <th>Metric</th>
                    {{#each parsers}}
                        <th>{{this.parserName}}</th>
                    {{/each}}
                    <th>Match</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Total Entities</td>
                    {{#each summary.totalEntityCounts}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalEntityMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Type Count</td>
                    {{#each summary.typeCounts}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{typeCountMatchClass}}"></span></td>
                </tr>
            </tbody>
        </table>

        <h4 style="margin-top: 1rem;">Geometry Comparison</h4>
        <table>
            <thead>
                <tr>
                    <th>Metric</th>
                    {{#each parsers}}
                        <th>{{this.parserName}}</th>
                    {{/each}}
                    <th>Match</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Geometry Entities</td>
                    {{#each geometry.entityCounts}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{geometryEntityMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Total Vertices</td>
                    {{#each geometry.totalVertexCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalVertexMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Total Triangles</td>
                    {{#each geometry.totalTriangleCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalTriangleMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Unique Vertices</td>
                    {{#each geometry.uniqueVertexCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{uniqueVertexMatchClass}}"></span></td>
                </tr>
            </tbody>
        </table>

        {{#if hasImages}}
            <div class="image-comparison-section">
                <h4 style="margin-top: 1rem;">Visual Comparison</h4>
                <div class="view-tabs">
                    {{#each views}}
                        <button class="view-tab {{#if @first}}active{{/if}}" data-view="{{this.viewId}}">
                            {{this.viewName}}
                            <span class="match-icon {{this.matchClass}}" style="margin-left: 0.5rem;"></span>
                        </button>
                    {{/each}}
                </div>
                {{#each views}}
                    <div class="view-content {{#if @first}}active{{/if}}" id="{{this.viewId}}">
                        <div class="image-comparison-grid">
                            <div class="image-comparison-card">
                                <div class="label">{{this.parserAName}}</div>
                                <img src="{{this.imageAPath}}" alt="Result A" onerror="this.style.display='none'">
                            </div>
                            <div class="image-comparison-card">
                                <div class="label">{{this.parserBName}}</div>
                                <img src="{{this.imageBPath}}" alt="Result B" onerror="this.style.display='none'">
                            </div>
                            <div class="image-comparison-card">
                                <div class="label">Difference ({{this.diffPercentage}})</div>
                                <img src="{{this.diffImagePath}}" alt="Diff" onerror="this.style.display='none'">
                            </div>
                        </div>
                        <div class="onion-slider-container">
                            <div class="label">Onion Skin Comparison</div>
                            <div class="onion-slider-wrapper">
                                <img class="image-a" src="{{this.imageAPath}}" alt="Result A">
                                <img class="image-b" src="{{this.imageBPath}}" alt="Result B" id="{{this.onionId}}">
                            </div>
                            <div class="onion-slider-controls">
                                <span class="slider-label">{{this.parserAName}}</span>
                                <input type="range" min="0" max="100" value="50"
                                    oninput="document.getElementById('{{this.onionId}}').style.opacity = this.value / 100">
                                <span class="slider-label">{{this.parserBName}}</span>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>
</div>