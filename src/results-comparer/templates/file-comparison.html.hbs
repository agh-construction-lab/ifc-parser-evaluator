<div class="file-comparison collapsible-section">
    <div class="file-header collapsible-header">
        <h2>Detailed Comparisons</h2>
        <div class="file-stats">
            <span class="stat-badge {{schemaMatchClass}}">
                Schema {{schemaMatchIcon}}
            </span>
            <span class="stat-badge {{summaryMatchClass}}">
                Summary {{summaryMatchIcon}}
            </span>
            <span class="stat-badge {{geometryMatchClass}}">
                Geometry {{geometryMatchIcon}}
            </span>
            <span class="stat-badge {{matrixMatchClass}}">
                Matrix {{matrixMatchIcon}}
            </span>
            <span class="stat-badge {{imagesMatchClass}}">
                Images {{imagesMatchIcon}}
            </span>
        </div>
    </div>
    <div class="file-details">
        <h4>Processing Time</h4>
        <table>
            <thead>
                <tr>
                    <th>Parser</th>
                    <th>Version</th>
                    <th>Time</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each parsers}}
                    <tr>
                        <td>{{this.parserName}}</td>
                        <td>{{this.parserVersion}}</td>
                        <td>{{this.processingTimeMs}} ms</td>
                        <td></td>
                    </tr>
                {{/each}}
            </tbody>
        </table>

        <h4 style="margin-top: 1rem;">Metadata Comparison</h4>
        <table>
            <thead>
                <tr>
                    <th>Metric</th>
                    {{#each parsers}}
                        <th>{{this.parserName}}</th>
                    {{/each}}
                    <th>Match</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Schema Version</td>
                    {{#each metadata.schemaVersions}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{schemaVersionMatchClass}}"></span></td>
                </tr>
            </tbody>
        </table>

        <h4 style="margin-top: 1rem;">Summary Comparison</h4>
        <table>
            <thead>
                <tr>
                    <th>Metric</th>
                    {{#each parsers}}
                        <th>{{this.parserName}}</th>
                    {{/each}}
                    <th>Match</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Total Entities</td>
                    {{#each summary.totalEntityCounts}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalEntityMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Type Count</td>
                    {{#each summary.typeCounts}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{typeCountMatchClass}}"></span></td>
                </tr>
            </tbody>
        </table>

        <h4 style="margin-top: 1rem;">Geometry Comparison</h4>
        <table>
            <thead>
                <tr>
                    <th>Metric</th>
                    {{#each parsers}}
                        <th>{{this.parserName}}</th>
                    {{/each}}
                    <th>Match</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Geometry Entities</td>
                    {{#each geometry.entityCounts}}
                        <td>{{this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{geometryEntityMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Total Vertices</td>
                    {{#each geometry.totalVertexCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalVertexMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Total Triangles</td>
                    {{#each geometry.totalTriangleCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalTriangleMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Unique Vertices</td>
                    {{#each geometry.uniqueVertexCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{uniqueVertexMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Line Vertices</td>
                    {{#each geometry.totalLineVertexCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalLineVertexMatchClass}}"></span></td>
                </tr>
                <tr>
                    <td>Line Segments</td>
                    {{#each geometry.totalLineSegmentCounts}}
                        <td>{{formatNumber this}}</td>
                    {{/each}}
                    <td><span class="match-icon {{totalLineSegmentMatchClass}}"></span></td>
                </tr>
            </tbody>
        </table>

        {{#if hasMatrixData}}
            <div class="collapsible-section inner-collapsible">
                <div class="collapsible-header">
                    <h4>Matrix Comparison</h4>
                    <span class="toggle-icon">▼</span>
                </div>
                <div class="collapsible-content">
                    {{#each matrixEntities}}
                        <div class="matrix-entity">
                            <div class="matrix-entity-header">
                                <span class="entity-id">{{this.globalId}}</span>
                                <span class="entity-class">({{this.ifcClass}})</span>
                                <span class="match-icon {{this.matchClass}}"></span>
                            </div>
                            <div class="matrix-grid">
                                {{#each this.parserMatrices}}
                                    <div class="matrix-card">
                                        <div class="label">{{this.parserName}}</div>
                                        <table class="matrix-table">
                                            {{#each this.rows}}
                                                <tr>
                                                    {{#each this}}
                                                        <td>{{this}}</td>
                                                    {{/each}}
                                                </tr>
                                            {{/each}}
                                        </table>
                                    </div>
                                {{/each}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}

        {{#if hasImages}}
            <div class="collapsible-section inner-collapsible">
                <div class="collapsible-header">
                    <h4>Visual Comparison</h4>
                    <span class="toggle-icon">▼</span>
                </div>
                <div class="collapsible-content">
                    <div class="image-comparison-section">
                        <div class="parser-selector-grid">
                            <label class="parser-select-group">
                                <span class="parser-select-label">Left Parser</span>
                                <select class="parser-select parser-select-left">
                                    {{#each visualComparison.parserOptions}}
                                        <option value="{{this.parserId}}" {{#if this.isDefaultLeft}}selected{{/if}}>
                                            {{this.label}}
                                        </option>
                                    {{/each}}
                                </select>
                            </label>
                            <label class="parser-select-group">
                                <span class="parser-select-label">Right Parser</span>
                                <select class="parser-select parser-select-right">
                                    {{#each visualComparison.parserOptions}}
                                        <option value="{{this.parserId}}" {{#if this.isDefaultRight}}selected{{/if}}>
                                            {{this.label}}
                                        </option>
                                    {{/each}}
                                </select>
                            </label>
                        </div>
                        <label class="vertex-spheres-toggle">
                            <input type="checkbox" class="vertex-spheres-checkbox">
                            <span>Show vertex-duplicate spheres</span>
                        </label>
                        <div class="view-tabs">
                            {{#each visualComparison.views}}
                                <button class="view-tab {{#if @first}}active{{/if}}" data-view="{{this.viewId}}">
                                    {{this.viewName}}
                                    <span class="match-icon view-tab-status {{this.defaultMatchClass}}" style="margin-left: 0.5rem;"></span>
                                </button>
                            {{/each}}
                        </div>
                        {{#each visualComparison.views}}
                            <div class="view-content {{#if @first}}active{{/if}}" id="{{this.viewId}}">
                                <script type="application/json" class="view-pairs-data">{{{this.pairsJson}}}</script>
                                <div class="image-comparison-grid">
                                    <div class="image-comparison-card">
                                        <div class="label parser-a-label">{{this.defaultLeftLabel}}</div>
                                        <img class="parser-a-image" src="{{this.defaultImageAPath}}" data-src-clean="{{this.defaultImageAPath}}" data-src-spheres="{{this.defaultSpheresImageAPath}}" alt="Result A" onerror="this.style.display='none'">
                                    </div>
                                    <div class="image-comparison-card">
                                        <div class="label parser-b-label">{{this.defaultRightLabel}}</div>
                                        <img class="parser-b-image" src="{{this.defaultImageBPath}}" data-src-clean="{{this.defaultImageBPath}}" data-src-spheres="{{this.defaultSpheresImageBPath}}" alt="Result B" onerror="this.style.display='none'">
                                    </div>
                                    <div class="image-comparison-card">
                                        <div class="label diff-label" data-diff-clean="{{this.defaultDiffPercentage}}" data-diff-spheres="{{this.defaultSpheresDiffPercentage}}">Difference ({{this.defaultDiffPercentage}})</div>
                                        <img class="diff-image" src="{{this.defaultDiffImagePath}}" data-src-clean="{{this.defaultDiffImagePath}}" data-src-spheres="{{this.defaultSpheresDiffImagePath}}" alt="Diff" onerror="this.style.display='none'">
                                    </div>
                                </div>
                                <div class="onion-slider-container">
                                    <div class="label">Onion Skin Comparison</div>
                                    <div class="onion-slider-wrapper">
                                        <img class="image-a parser-a-onion-image" src="{{this.defaultImageAPath}}" data-src-clean="{{this.defaultImageAPath}}" data-src-spheres="{{this.defaultSpheresImageAPath}}" alt="Result A">
                                        <img class="image-b parser-b-onion-image" src="{{this.defaultImageBPath}}" data-src-clean="{{this.defaultImageBPath}}" data-src-spheres="{{this.defaultSpheresImageBPath}}" alt="Result B" id="{{this.onionId}}">
                                    </div>
                                    <div class="onion-slider-controls">
                                        <span class="slider-label parser-a-slider-label">{{this.defaultLeftLabel}}</span>
                                        <input type="range" min="0" max="100" value="50" class="onion-slider"
                                            oninput="document.getElementById('{{this.onionId}}').style.opacity = this.value / 100">
                                        <span class="slider-label parser-b-slider-label">{{this.defaultRightLabel}}</span>
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        {{/if}}
    </div>
</div>
