<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IFC Parser Comparison Report</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <style>
    {{{styles}}}
    </style>
</head>

<body>
    <div class="container">
        <header>
            <h1>🏗️ IFC Parser Comparison Report</h1>
            <p class="meta">
                File: 📄 {{fileName}} |
                Generated: {{generatedAt}} |
                Parsers: {{parsersCompared}}
            </p>
        </header>

        <section class="summary-grid">
            <div class="summary-card">
                <h3>Metadata Match</h3>
                <div class="value" style="color: {{metadataMatchColor}}">
                    {{metadataMatchRate}}%
                </div>
            </div>
            <div class="summary-card">
                <h3>Summary Match</h3>
                <div class="value" style="color: {{summaryMatchColor}}">
                    {{summaryMatchRate}}%
                </div>
            </div>
            <div class="summary-card">
                <h3>Geometry Match</h3>
                <div class="value" style="color: {{geometryMatchColor}}">
                    {{geometryMatchRate}}%
                </div>
            </div>
            <div class="summary-card">
                <h3>Matrix Match</h3>
                <div class="value" style="color: {{matrixMatchColor}}">
                    {{matrixMatchRate}}%
                </div>
            </div>
            <div class="summary-card">
                <h3>Image Match</h3>
                <div class="value" style="color: {{imageMatchColor}}">
                    {{imageMatchRate}}%
                </div>
                <div class="sub-value">Avg diff: {{averagePixelDiff}}%</div>
            </div>
        </section>

        <section class="charts-grid">
            <div class="chart-card">
                <h2>Match Rate by Category</h2>
                <div class="chart-container">
                    <canvas id="matchRateChart"></canvas>
                </div>
            </div>
            <div class="chart-card">
                <h2>Processing Time (ms)</h2>
                <div class="chart-container">
                    <canvas id="processingTimeChart"></canvas>
                </div>
            </div>
        </section>

        <div class="collapsible-section">
            <div class="collapsible-header" onclick="this.parentElement.classList.toggle('open')">
                <h2>Geometry Charts: General</h2>
                <span class="toggle-icon">▼</span>
            </div>
            <div class="collapsible-content">
                <div class="charts-grid">
                    <div class="chart-card">
                        <h2>Total Vertex Count</h2>
                        <div class="chart-container">
                            <canvas id="vertexChart"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <h2>Unique Vertex Count</h2>
                        <div class="chart-container">
                            <canvas id="uniqueVertexChart"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <h2>Triangle Count</h2>
                        <div class="chart-container">
                            <canvas id="triangleChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="collapsible-section">
            <div class="collapsible-header" onclick="this.parentElement.classList.toggle('open')">
                <h2>Geometry Charts: By IFC Class</h2>
                <span class="toggle-icon">▼</span>
            </div>
            <div class="collapsible-content">
                <div id="classesWithoutGeometry"></div>
                <div id="classByClassCharts"></div>
            </div>
        </div>

        <div class="comparisons-container">
            {{{comparisons}}}
        </div>

        <footer>
            <p>stryczek.pl</p>
        </footer>
    </div>

    <script>
        window.reportData = {{{reportData}}};
    </script>
    <script>
        {{{scripts}}}
    </script>
</body>

</html>